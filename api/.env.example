# --- Sunucu ---
PORT=4000
NODE_ENV=development

# --- Veritabani (Neon / yerel Postgres) ---
# Neon ornegi: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/kardiyo?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kardiyo
# Neon gibi yonetilen servislerde true yapin
DATABASE_SSL=false

# --- JWT ---
# Uretimde mutlaka degistirin: openssl rand -hex 48
JWT_ACCESS_SECRET=degistir-bu-degeri-access
JWT_REFRESH_SECRET=degistir-bu-degeri-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
# Virgulle ayrilmis izinli origin listesi
CORS_ORIGINS=http://localhost:5173,https://10adimdakardiyoloji.com

# --- Ilk admin (seed scripti kullanir) ---
ADMIN_EMAIL=admin@10adimdakardiyoloji.com
# Yalnizca seed icin kullanilir. Yayina almadan once `npm run set-admin-password`
# ile degistirin; asagidaki ornek deger herkese acik, oldugu gibi birakmayin.
ADMIN_PASSWORD=degistir-beni
ADMIN_NAME=Sistem Yoneticisi

# --- Cloudflare R2 (video/gorsel yukleme) ---
# Bos birakilirsa dosya yukleme kapali olur, sadece YouTube/Vimeo linki calisir
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kardiyo-media
# Bucket'in herkese acik okuma adresi (ornek: https://media.10adimdakardiyoloji.com)
R2_PUBLIC_URL=
